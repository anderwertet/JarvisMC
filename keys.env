# Скопируй в keys.env и заполни. Формат ИМЯ=значение, кавычки не нужны.
# Пустое значение = провайдер пропускается.

# ---------------------------------------------------------------------------
# Мозг. Приоритет при JARVIS_LLM=auto: llm7 -> aimlapi -> github -> openrouter -> custom -> ollama
# ---------------------------------------------------------------------------

# LLM7 — бесплатный ключ, работает из РФ. https://dash.llm7.io/#/api-keys
LLM7_API_KEY=

# AI/ML API — бесплатный тариф, есть линейка DeepSeek. https://aimlapi.com/app/keys
AIMLAPI_KEY=

# SambaNova Cloud — бесплатно без карты. https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=

# GitHub Models и OpenRouter с некоторых сетей недоступны (перехват/403).
GITHUB_TOKEN=
OPENROUTER_API_KEY=

# Платные и подписки: в auto не участвуют, только через JARVIS_LLM=<имя>
OPENCODE_API_KEY=
DEEPSEEK_API_KEY=

# Любой OpenAI-совместимый эндпоинт: JARVIS_LLM=custom
JARVIS_LLM_URL=
JARVIS_LLM_MODEL=
JARVIS_LLM_KEY=

# ---------------------------------------------------------------------------
# Голос
# ---------------------------------------------------------------------------

# Fish Audio — настоящий голос Джарвиса, доступен из РФ. https://fish.audio/app/api-keys
FISH_API_KEY=
# Голоса по умолчанию: английский MCU-Джарвис и русский Jarvis.
# Свой id взять из адреса страницы голоса на fish.audio.
JARVIS_FISH_EN=612b878b113047d9a770c069c8b4fdfe
JARVIS_FISH_RU=680d74fbef69419f87cfc70f092a1451

# ElevenLabs — качественнее, но гео-блокировка по IP. Нужен прокси вне РФ.
ELEVENLABS_API_KEY=
JARVIS_ELEVEN_VOICE=
JARVIS_ELEVEN_PROXY=

# ---------------------------------------------------------------------------
# Поведение моста
# ---------------------------------------------------------------------------

# auto — сначала бесплатное облако, при отказе локальная модель; ollama — только локально
JARVIS_LLM=auto
# Локальная модель Ollama для фолбэка
JARVIS_MODEL=llama3.1:8b
# Распознавание: turbo (точно) или small (быстро, но плохо по-русски)
JARVIS_STT_MODEL=turbo
# Локальный клон XTTS вместо Fish: 1 = включён, но нужны модели на диске
JARVIS_XTTS=0
# Сколько тишины завершает фразу, секунды
JARVIS_SILENCE=0.75
# Предел длины ответа в символах
JARVIS_MAX_REPLY=320
